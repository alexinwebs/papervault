# PaperVault production configuration.
# Copy to .env.production, fill in every value, and never commit the result.
# The server validates this at boot and refuses to start on unsafe settings.

# --- Used by docker-compose.prod.yml ---------------------------------------
# DNS A/AAAA record must point at this server
SITE_DOMAIN=papers.example.org
# openssl rand -hex 24
POSTGRES_PASSWORD=
# e.g. the git commit SHA
APP_VERSION=

# --- Core -----------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://papers.example.org
# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -hex 32
CRON_SECRET=
# DATABASE_URL is set by docker compose. On other platforms:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/papervault?schema=public&sslmode=require

# --- Operator and legal contacts (shown on Terms, Privacy, security.txt) ---
OPERATOR_NAME=
CONTACT_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
SECURITY_CONTACT_EMAIL=

# --- Mail (required: verification and password reset) ----------------------
MAIL_DRIVER=smtp
# e.g. smtp.resend.com / email-smtp.ap-south-1.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PaperVault <no-reply@papers.example.org>"
# Or MAIL_DRIVER=resend (RESEND_API_KEY) / postmark (POSTMARK_SERVER_TOKEN,
# POSTMARK_MESSAGE_STREAM). The sender domain must be verified (SPF/DKIM).
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
# Operations mailbox for tickets, teacher verifications, requests and reports.
ADMIN_EMAIL=papervaultt@gmail.com

# --- Support and teacher verification -------------------------------------
# Closed at launch: the page says "not open yet". Set true to accept applications.
TEACHER_VERIFICATION_ENABLED=false
TEACHER_DOC_RETENTION_DAYS=30
TEACHER_REAPPLY_COOLDOWN_DAYS=7

# --- File storage ---------------------------------------------------------
# "s3" for any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2).
# "local" keeps uploads on the compose `uploads` volume: fine for one server,
# but back that volume up.
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
# R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# AES256 on AWS if you want it explicit
S3_SSE=none
# keep false: files stream through the authorising route
S3_SIGNED_URLS=false
MAX_UPLOAD_BYTES=10485760

# --- Safety ---------------------------------------------------------------
# MALWARE_SCANNER, CLAMAV_* and REDIS_URL are set by docker compose.
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_ADMIN_2FA=true

# Reverse proxies in front of the app. The client IP used for rate limits is
# the Nth X-Forwarded-For entry from the right. 1 = Caddy (production compose).
# 0 = reached directly; forwarding headers are then ignored.
TRUSTED_PROXY_HOPS=1

# --- Monitoring (recommended) ---------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Buy me a coffee (/coffee) ---------------------------------------------
# UPI tips go straight to this ID. Leave empty to hide the page and links.
DONATION_UPI_ID=youralexhere-2@oksbi
DONATION_PAYEE_NAME=ALEX
