# Local development. `docker compose up -d` starts Postgres, Redis and ClamAV
# with exactly these settings. Production uses .env.production.example.
DATABASE_URL="postgresql://postgres:papervault@localhost:5432/papervault?schema=public"

# 32+ char secret used to sign session cookies.
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"

# Storage: "local" (default) or "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

MAX_UPLOAD_BYTES="10485760"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: non-interactive input for \`npm run admin:create\`.
# Leave these blank to be prompted instead (the password is never echoed).
# ADMIN_NAME="Your Name"
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Email notifications (approval requests to admins, decisions to contributors)
# ---------------------------------------------------------------------------
# MAIL_DRIVER: "gmail" | "smtp" | "resend" | "postmark" | "log". Defaults to "gmail" when GMAIL_USER and
# GMAIL_APP_PASSWORD are set, otherwise "log" (recorded in /admin/notifications
# but not delivered).
MAIL_DRIVER="log"

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-character value.
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# Any other SMTP provider
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# Transactional email APIs (HTTPS, no SMTP). MAIL_FROM must be a sender on a
# domain you have verified with the provider.
# RESEND_API_KEY=""
# POSTMARK_SERVER_TOKEN=""
# POSTMARK_MESSAGE_STREAM="outbound"

# From header.
# MAIL_FROM="PaperVault <you@gmail.com>"
# Operations mailbox: receives new tickets, teacher verification requests,
# college/subject requests, member reports and takedown notices. It is also the
# default login email for `npm run admin:create` (see ADMIN_NAME above).
# ADMIN_NOTIFY_EMAIL is the older name and still works.
# ADMIN_EMAIL="papervaultt@gmail.com"

# ---------------------------------------------------------------------------
# Support tickets and teacher verification
# ---------------------------------------------------------------------------
# Set to "false" to close new teacher verification applications (the page then
# says "not open yet"; existing requests can still be reviewed).
TEACHER_VERIFICATION_ENABLED="true"
# Teacher verification documents are deleted this many days after a decision.
TEACHER_DOC_RETENTION_DAYS="30"
# Days a rejected applicant waits before re-applying.
TEACHER_REAPPLY_COOLDOWN_DAYS="7"
# Per-file limits for private documents (bytes). Defaults: 5 MB each.
# TEACHER_DOC_MAX_BYTES="5242880"
# TICKET_ATTACHMENT_MAX_BYTES="5242880"
# Accounts on this domain are treated as demo data by `npm run db:purge-demo`.
# DEMO_EMAIL_DOMAIN="papervault.dev"

# ---------------------------------------------------------------------------
# Security and scale
# ---------------------------------------------------------------------------
# Shared rate-limit window across instances. Without it limits are per-process.
# REDIS_URL="redis://localhost:6379"

# Malware scanning for uploads: "clamav" or "none". Production requires clamav.
# ClamAV needs a few minutes on first start to download signatures.
MALWARE_SCANNER="none"
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT="3310"

# Set to "false" only for local testing; unverified accounts can then upload.
REQUIRE_EMAIL_VERIFICATION="true"

# Shared secret for the nightly maintenance endpoint (POST /api/cron/purge).
CRON_SECRET=

# Two-factor enforcement for admin screens. Defaults to on in production.
# Sign-in attempts allowed per account per minute. Defaults to 10. The
# end-to-end suite signs the same seeded accounts in far more often than a
# person would, so local test runs raise it.
LOGIN_ATTEMPTS_PER_MINUTE=
# New accounts allowed per client IP per hour. Defaults to 60 (a class signing
# up together behind one campus network). Test runs raise it.
REGISTRATIONS_PER_IP_PER_HOUR=

REQUIRE_ADMIN_2FA=

# Reverse proxies in front of the app. The client IP used for rate limits is
# the Nth X-Forwarded-For entry from the right. 1 = Caddy (production compose).
# 0 = reached directly; forwarding headers are then ignored.
TRUSTED_PROXY_HOPS=

# Optional error reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Reported by GET /api/healthz so you can tell which build is live.
# Set this to the commit SHA in CI.
# APP_VERSION="dev"

# Operator contact shown on the legal pages and in /.well-known/security.txt.
# Required in production.
# CONTACT_EMAIL="you@example.com"

# ---------------------------------------------------------------------------
# "Buy me a coffee" page (/coffee) — UPI tips straight to the admin
# ---------------------------------------------------------------------------
# Leave DONATION_UPI_ID empty to hide the page and its links.
DONATION_UPI_ID="youralexhere-2@oksbi"
DONATION_PAYEE_NAME="ALEX"
# Image in /public shown as the QR code.
# DONATION_QR_PATH="/donate/upi-qr.jpg"
